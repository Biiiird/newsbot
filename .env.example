# ---------- Core ----------
# Where the SQLite database lives
DB_PATH=data/newsbot.db
# Path to the sources list
SOURCES_FILE=config/sources.yaml
# true = nothing is really posted; publisher prints to the console instead
DRY_RUN=true
LOG_LEVEL=INFO

# ---------- Claude ----------
# LLM_PROVIDER options:
#   claude_cli -> uses your Claude Pro/Max subscription through Claude Code (`claude -p`).
#                 Needs Claude Code installed and logged in once. If ANTHROPIC_API_KEY is also set,
#                 the API is used automatically when the subscription limit is reached.
#   anthropic  -> API key only (https://console.anthropic.com), billed per use
#   mock       -> keyword heuristic, no Claude at all
LLM_PROVIDER=claude_cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_MODEL=haiku
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# ---------- Telegram bot (create one with @BotFather) ----------
TELEGRAM_BOT_TOKEN=
# Public channel the bot posts to, e.g. @my_news_channel (bot must be an admin there)
TELEGRAM_CHANNEL_ID=
# Your private chat with the bot, where drafts arrive for approval.
# Run `python -m newsbot whoami` after messaging the bot to find it.
ADMIN_CHAT_ID=
# Comma-separated Telegram user IDs allowed to approve (defaults to ADMIN_CHAT_ID)
ADMIN_USER_IDS=
# Add "Source: <link>" under Telegram posts
TELEGRAM_INCLUDE_SOURCE=true
# Attach portraits (Wikipedia) of the public figures a story is about to Telegram posts.
# Stories not about a person get no pictures. Posts fall back to text if images fail.
ATTACH_IMAGES=true
MEDIA_MAX_IMAGES=2
# Skip portraits whose original is smaller than this on its shorter side (pixels).
# Video stills and screenshots are always skipped.
MEDIA_MIN_SIDE=600

# ---------- Telegram reader (optional, https://my.telegram.org -> API development tools) ----------
# Reads public channels as a normal user account. Leave empty to disable.
TG_API_ID=
TG_API_HASH=
TG_SESSION=data/reader

# ---------- X / Twitter (optional) ----------
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Post the source link as a reply (links in the main post get less reach)
X_SOURCE_REPLY=true

# ---------- Routing ----------
# Drafts scoring below this are dropped (0-10)
MIN_IMPORTANCE=6
# Auto-publish without approval: needs AUTO_POST=true and score >= AUTO_MIN_IMPORTANCE,
# plus (unless turned off below) low risk and a high-trust source. Keep false while testing.
AUTO_POST=false
AUTO_MIN_IMPORTANCE=8
AUTO_REQUIRE_LOW_RISK=true
AUTO_REQUIRE_HIGH_TRUST=true
# Ignore items older than this (stops the first run from posting yesterday's news)
MAX_ITEM_AGE_MIN=120

# ---------- Timing / limits ----------
RSS_POLL_SEC=60
MIN_POST_INTERVAL_SEC=120
MAX_POSTS_PER_HOUR=12
# Similarity (0-100) above which two headlines count as the same story
DEDUP_THRESHOLD=85
DEDUP_WINDOW_HOURS=12
